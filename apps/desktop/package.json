{
  "name": "@harness/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "tsc -b && node scripts/build-preload.js && electron .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Personal Harness uses your microphone to record dictation that you choose to send to OpenAI for transcription."
      },
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    }
  }
}
