{
  "name": "@harness/desktop",
  "productName": "TasteCode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "tsc -b && node scripts/build-preload.js && electron .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@harness/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.4.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "icon": "assets/tastecode-icon.png",
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TasteCode uses your microphone to record dictation that you choose to send to OpenAI for transcription."
      },
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    }
  }
}
