{
  "name": "@harness/desktop",
  "productName": "Taste Code",
  "description": "A local desktop workspace for coding agents.",
  "homepage": "https://tastecode.dev",
  "author": "Tasteskill Team",
  "license": "Apache-2.0",
  "copyright": "made by @blueemi99 and @lexnlin on X :)",
  "desktopName": "dev.tastecode.desktop.desktop",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b && node scripts/build-main.js",
    "build:main": "node scripts/build-main.js",
    "benchmark:startup": "node scripts/benchmark-startup.js",
    "benchmark:startup:compare": "node scripts/compare-startup.js",
    "typecheck": "tsc -b",
    "start": "tsc -b && node scripts/build-main.js && node scripts/build-preload.js && node scripts/start.js",
    "test": "vitest run src --passWithNoTests",
    "dist": "pnpm -w licenses:verify && pnpm -w build && node ../../tools/scripts/build-provenance.js && node scripts/build-preload.js && electron-builder",
    "dist:dir": "pnpm -w licenses:verify && pnpm -w build && node ../../tools/scripts/build-provenance.js && node scripts/build-preload.js && electron-builder --dir",
    "dist:linux:dir": "pnpm -w licenses:verify && pnpm -w build && node ../../tools/scripts/build-provenance.js && node scripts/build-preload.js && electron-builder --linux dir --x64",
    "verify:native-bindings": "node scripts/run-native-binding-proof.js"
  },
  "dependencies": {
    "@harness/contracts": "workspace:*",
    "@harness/proc": "workspace:*",
    "@harness/server": "workspace:*",
    "electron-updater": "6.8.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.tastecode.desktop",
    "icon": "assets/tastecode-app-icon.png",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/**/*.node",
      "node_modules/**/node-pty/prebuilds/**/spawn-helper"
    ],
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/@harness/*/src{,/**/*}",
      "!node_modules/@harness/*/tsconfig*.json",
      "!node_modules/@harness/*/*.tsbuildinfo",
      "!node_modules/@harness/*/dist/**/*.d.ts",
      "!node_modules/@harness/*/dist/**/*.map",
      "!node_modules/@harness/*/dist/**/*.bench.js"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../licenses",
        "to": "licenses"
      },
      {
        "from": "../../release/THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      },
      {
        "from": "../../release/build-provenance.json",
        "to": "BUILD_PROVENANCE.json"
      }
    ],
    "directories": {
      "output": "../../release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://tastecode.dev/releases"
      }
    ],
    "artifactName": "TasteCode-${version}-${os}-${arch}.${ext}",
    "linux": {
      "executableName": "tastecode",
      "icon": "assets/tastecode-app-icon.png",
      "category": "Development",
      "synopsis": "Local desktop workspace for coding agents",
      "description": "A local desktop workspace for coding agents.",
      "maintainer": "Tasteskill Team",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "syncDesktopName": true,
      "files": [
        "!dist/**/*.map",
        "!dist/**/*.d.ts",
        "!node_modules/node-pty/prebuilds/darwin-*/**/*",
        "!node_modules/node-pty/prebuilds/linux-arm64/**/*",
        "!node_modules/node-pty/prebuilds/win32-*/**/*",
        "!node_modules/node-pty/scripts/**/*",
        "!node_modules/node-pty/src/win/**/*",
        "!node_modules/node-pty/typings/**/*"
      ]
    },
    "deb": {
      "packageName": "tastecode",
      "packageCategory": "devel",
      "fpm": [
        "--depends",
        "libasound2t64 | libasound2"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "assets/tastecode-icon.icon",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TasteCode uses your microphone to record dictation that you choose to send to OpenAI for transcription."
      },
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    }
  }
}
