{
  "name": "@harness/desktop",
  "productName": "Taste Code",
  "description": "A local desktop workspace for coding agents.",
  "author": "TasteCode",
  "copyright": "Copyright © 2026 TasteCode",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "start": "tsc -b && node scripts/build-preload.js && node scripts/start.js",
    "test": "vitest run --passWithNoTests",
    "dist": "pnpm -w licenses:verify && pnpm -w build && node scripts/build-preload.js && electron-builder",
    "dist:dir": "pnpm -w licenses:verify && pnpm -w build && node scripts/build-preload.js && electron-builder --dir",
    "verify:native-bindings": "node scripts/run-native-binding-proof.js"
  },
  "dependencies": {
    "@harness/contracts": "workspace:*",
    "@harness/server": "workspace:*",
    "electron-updater": "6.8.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.tastecode.desktop",
    "executableName": "TasteCode",
    "icon": "assets/tastecode-app-icon.png",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/@harness/*/src{,/**/*}",
      "!node_modules/@harness/*/tsconfig*.json",
      "!node_modules/@harness/*/*.tsbuildinfo"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../licenses",
        "to": "licenses"
      },
      {
        "from": "../../release/THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      }
    ],
    "directories": {
      "output": "../../release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Leonxlnx",
        "repo": "tastecode",
        "channel": "beta",
        "releaseType": "prerelease"
      }
    ],
    "artifactName": "TasteCode-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "assets/tastecode-icon.icon",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TasteCode uses your microphone to record dictation that you choose to send to OpenAI for transcription."
      },
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    }
  }
}
