{
  "name": "personal-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @harness/server build && node tools/scripts/dev.js",
    "harness": "tsc -b apps/server && node apps/server/dist/cli.js",
    "dev:mobile": "pnpm --filter @harness/server build && node tools/scripts/dev.js --mobile",
    "mobile:ios": "node tools/scripts/mobile-ios.js",
    "mobile:ios:device": "node tools/scripts/mobile-ios.js --device",
    "mobile:ios:build": "node tools/scripts/mobile-ios.js --build",
    "mobile:ios:test": "node tools/scripts/mobile-ios.js --test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
