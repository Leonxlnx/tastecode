{
  "name": "tastecode",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node tools/scripts/dev.js",
    "harness": "tsc -b apps/server && node apps/server/dist/cli.js",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^26.1.1",
    "oxlint": "1.78.0",
    "prettier": "^3.9.6",
    "tslib": "2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
